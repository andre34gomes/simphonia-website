# Cloudflare Pages custom response headers.
#
# IMPORTANT: Cloudflare Pages is the confirmed live deployment target for
# this site (see .github/workflows/deploy.yml). netlify.toml and vercel.json
# already define an equivalent, previously-reviewed set of security headers
# and Cache-Control rules for their respective platforms, but Cloudflare
# Pages does NOT read either of those files — it requires its own `_headers`
# file (this file) using the format below. Without it, none of the
# Cache-Control / CSP / security headers defined for Netlify/Vercel are
# actually sent by the live site.
#
# This file mirrors the values already defined in netlify.toml so all three
# hosting configs stay in parity. Keep them in sync if either changes.

# ── Security headers — applied to every response ────────────────────────────
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' https://images.unsplash.com https://api.simphonia.pt https://flagcdn.com data: blob:; connect-src 'self' https://api.simphonia.pt; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests;

# ── Cache-Control — immutable long-lived caching for versioned static assets ─
# Every reference to these files in HTML includes a `?v=` cache-busting query
# param that changes when content changes, so a 1-year immutable cache is
# safe: browsers/CDN edges never need to revalidate, eliminating a network
# round trip on every repeat visit for a globally-distributed audience.
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ── HTML — always revalidate so SPA shell/router updates propagate quickly ──
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Sensitive bearer-token entry points must never be cached by a browser or CDN.
/reset-password/*
  Cache-Control: no-store

/reset-password
  Cache-Control: no-store

/verify-email/*
  Cache-Control: no-store

/verify-email
  Cache-Control: no-store

# ── Web App Manifest — short cache so PWA metadata updates are picked up ────
/manifest.json
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: application/manifest+json
